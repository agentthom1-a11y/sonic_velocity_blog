# ============================================================
#  SonicVelo Blog — Environment Variables
#  Copy this file to .env.local and fill in the values.
#  NEVER commit .env.local to version control.
# ============================================================

# -----------------------------------------------------------
# Session Security (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# -----------------------------------------------------------
# Demo Accounts (server-side only — never exposed to client)
# -----------------------------------------------------------
DEMO_S1_EMAIL=s1@velocity.ai
DEMO_S1_PASSWORD=velocity2025
DEMO_S2_EMAIL=s2@velocity.ai
DEMO_S2_PASSWORD=velocity2025

# -----------------------------------------------------------
# Express Backend (only needed when IS_DEMO_MODE = false)
# -----------------------------------------------------------
# Backend auth token — keep long and random, server-side only
BACKEND_AUTH_TOKEN=replace-with-long-random-token
# The Express server's public base URL (for track file URLs)
PUBLIC_BASE_URL=http://localhost:8080
# CORS — which origin the Express server allows
ALLOWED_ORIGIN=http://localhost:3000

# -----------------------------------------------------------
# Frontend public vars (safe to expose — no secrets!)
# -----------------------------------------------------------
# Only set this if you want the frontend to call the backend directly
# (not recommended — use /api/proxy/* instead)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
